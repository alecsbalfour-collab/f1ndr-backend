import json
import os

class Trinn:
    def __init__(self):
        # Resolve JSON path (works locally + on Render)
        base_dir = os.path.dirname(os.path.abspath(__file__))
        json_path = os.path.join(base_dir, "..", "data", "trinn_character.json")
        json_path = os.path.normpath(json_path)

        if not os.path.exists(json_path):
            raise FileNotFoundError(f"Missing JSON file: {json_path}")

        # Load enterprise-level JSON
        with open(json_path, "r") as f:
            self.data = json.load(f)

        # Extract core components
        self.character = self.data.get("character", {})
        self.states = self.data.get("states", {})
        self.transitions = self.data.get("transitions", {})
        self.safety = self.data.get("safety", {})
        self.metadata = self.data.get("metadata", {})

        # Initial state
        self.state = self.character.get("state", "idle")

    # -----------------------------
    # Safety Layer
    # -----------------------------
    def _safety_check(self, user_input):
        max_len = self.safety.get("max_input_length", 500)
        blocked = self.safety.get("blocked_phrases", [])

        if len(user_input) > max_len:
            return {
                "response": "Your message is too long to process safely.",
                "state": self.state
            }

        for phrase in blocked:
            if phrase.lower() in user_input.lower():
                return {
                    "response": self.safety.get(
                        "fallback_response",
                        "I can't help with that."
                    ),
                    "state": self.state
                }

        return None  # Safe

