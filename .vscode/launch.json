{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "f1ndr Backend (Uvicorn Direct)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "run_backend:app",
                "--reload",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
